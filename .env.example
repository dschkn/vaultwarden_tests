# Target application. Use a disposable test deployment, never a personal vault.
TEST_BASE_URL=http://localhost:8080

# Required only for the authenticated suite.
TEST_EMAIL=qa@example.test
TEST_PASSWORD=replace-with-a-test-only-password

# Optional Selenoid connection settings.
SELENOID_HOST=localhost
SELENOID_PORT=4444
SELENOID_BROWSER=chrome
SELENOID_BROWSER_VERSION=128.0
