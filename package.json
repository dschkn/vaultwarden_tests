{
  "name": "vaultwarden_tests",
  "type": "module",
  "devDependencies": {
    "@wdio/cli": "^8.39.0",
    "@wdio/local-runner": "^8.39.0",
    "@wdio/mocha-framework": "^8.39.0",
    "@wdio/spec-reporter": "^8.39.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.2"
  },
  "scripts": {
    "test": "npm run test:e2e",
    "test:e2e": "wdio run ./wdio.conf.ts",
    "test:smoke": "wdio run ./wdio.conf.ts --suite smoke",
    "test:registration": "wdio run ./wdio.conf.ts --suite registration",
    "test:authenticated": "wdio run ./wdio.conf.ts --suite authenticated",
    "test:selenoid": "wdio run ./wdio.selenoid.conf.ts",
    "test:check": "tsc --noEmit"
  }
